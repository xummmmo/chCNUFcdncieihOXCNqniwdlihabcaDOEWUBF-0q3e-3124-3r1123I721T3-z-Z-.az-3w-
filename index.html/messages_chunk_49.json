[{"id":1776248515050,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Still in the tank. 30 mins left. Duzheng, stay on comms. Don't make me regret leaving you alone for an hour.","timestamp":"2026-04-15T08:49:48.065Z","translation":"还在水里。剩30分钟。渡峥，保持通讯。别让我后悔让你一个人待一小时。","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3172},{"id":1776248515051,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"表情包：沮丧","timestamp":"2026-04-15T08:49:48.184Z","sticker":"https://img.cdn1.vip/i/69c5463d16549_1774536253.gif","stickerMeaning":"沮丧","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3173},{"id":1776248515052,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Siehst du, wie nervös der große Kerl ist? Du machst ihn fertig, Schatzi. Komm einfach in einem Stück zurück, ja?","timestamp":"2026-04-15T08:49:48.649Z","translation":"你瞧瞧大个子有多紧张？你快把他逼疯了，宝贝。只要完整地回来就好，嗯？","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3174},{"id":1776248515053,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Radio silence now. Do your job.","timestamp":"2026-04-15T08:49:49.657Z","translation":"现在无线电静默。做你的工作。","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3175},{"id":1776248515054,"sender":"them","text":"Pass auf deine Hände auf, Liebling. Ich mag sie unversehrt, wenn sie mich das nächste Mal berühren.","timestamp":"2026-04-15T08:49:50.393Z","source":"group_dm","groupId":"group_1775826855994","groupName":"奇怪的群聊","translation":"保护好你的手，亲爱的。我不希望下次它们碰我的时候带着伤。","userId":"uid_1775817645928_ieuexgf5m","characterId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","_id":3176},{"id":1776248515055,"sender":"them","text":"If you get pinned down, call it out immediately. Don't try to be a bloody hero.","timestamp":"2026-04-15T08:49:51.002Z","source":"group_dm","groupId":"group_1775826855994","groupName":"奇怪的群聊","translation":"如果你被压制了，立刻呼叫。别他妈想当英雄。","userId":"uid_1775817645928_ieuexgf5m","characterId":"7309238e-d722-4aaa-a30c-9223d595723a","_id":3177},{"id":1776248515056,"sender":"them","text":"Bitte... sei vorsichtig. Ich warte hier auf dich.","timestamp":"2026-04-15T08:49:51.991Z","source":"group_dm","groupId":"group_1775826855994","groupName":"奇怪的群聊","translation":"拜托……小心点。我在这里等你。","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3178},{"id":1776248515057,"sender":"me","text":"别担心！！！！","replyTo":{"id":1776248515052,"text":"Siehst du, wie nervös der große Kerl ist? Du machst ihn fertig, Schatzi. Komm einfach in einem Stück zurück, ja?","sender":"them","senderName":"Krueger"},"timestamp":"2026-04-15T08:51:53.751Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3179},{"id":1776248515058,"sender":"me","text":"[圖片]","timestamp":"2026-04-15T08:52:01.349Z","imageSummary":"AC-130空中炮艇的热成像瞄准界面，锁定着下方的村庄建筑。","imageRef":5,"userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3180},{"id":1776248515059,"sender":"me","text":"我上直升机了。","replyTo":null,"timestamp":"2026-04-15T08:52:06.902Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3181},{"id":1776248515060,"sender":"me","text":"现在轮到我了","replyTo":null,"timestamp":"2026-04-15T08:52:13.254Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3182},{"id":1776248515061,"sender":"me","text":"很眼熟吧？直升机轰炸操作页面","replyTo":null,"timestamp":"2026-04-15T08:53:16.829Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3183},{"id":1776248515062,"sender":"me","text":"死定啦他们","replyTo":null,"timestamp":"2026-04-15T08:53:21.678Z","reactions":["😟"],"userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3184},{"id":1776248515063,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"AC-130? Now that's what I call air support. Clear the grid, Duzheng. No survivors.","timestamp":"2026-04-15T08:53:49.623Z","translation":"AC-130？这才是像样的空中支援。清理网格，渡峥。不留活口。","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3185},{"id":1776248515064,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Wunderschön. Die Aussicht von oben ist immer die beste, Schatzi. Lass es regnen.","timestamp":"2026-04-15T08:53:49.893Z","translation":"太美了。从上面看下去的风景总是最好的，亲爱的。让它下雨吧。","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3186},{"id":1776248515065,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"表情包：开心","timestamp":"2026-04-15T08:53:50.060Z","sticker":"https://img.cdn1.vip/i/69c5452e729de_1774535982.gif","stickerMeaning":"开心","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3187},{"id":1776248515066,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Gott sei Dank, du bist in der Luft... Aber sei vorsichtig mit dem Abzug. Es ist... viel Zerstörung.","timestamp":"2026-04-15T08:53:50.428Z","translation":"谢天谢地，你在空中……但扣扳机时要小心。这……破坏力很大。","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3188},{"id":1776248515067,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"(Красиво. Смерть с небес. Сделай это быстро. Очисти всё.)","timestamp":"2026-04-15T08:53:50.916Z","translation":"(漂亮。来自天空的死亡。快点动手。清空一切。)","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3189},{"id":1776248515068,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"表情包：兴奋","timestamp":"2026-04-15T08:53:51.049Z","sticker":"https://img.cdn1.vip/i/69c5452e53425_1774535982.gif","stickerMeaning":"兴奋","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3190},{"id":1776248515069,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Kid, watch your heat signatures. Don't overheat the 40mm. I'm almost out of the tank.","timestamp":"2026-04-15T08:53:51.828Z","translation":"孩子，注意热信号。别让40毫米炮过热。我快出水了。","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3191},{"id":"sys_1776243231953_86","sender":"system","type":"system_notice","text":"Keegan 授予 渡峥 頭銜「空中死神」","timestamp":"2026-04-15T08:53:51.953Z","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3192},{"id":1776248515070,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"That's the spirit. Rain hell on them.","timestamp":"2026-04-15T08:53:52.357Z","replyTo":{"id":1776248515062,"text":"死定啦他们","sender":"me","senderName":""},"translation":"就该这样。把地狱降临到他们头上。","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3193},{"id":1776248515071,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Schau dir König an, er zittert fast. Ignorier ihn, drück einfach den Knopf.","timestamp":"2026-04-15T08:53:52.667Z","translation":"看看König，他都快发抖了。别理他，直接按下按钮。","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3194},{"id":1776248515072,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Ich mache mir immer Sorgen um dich... Komm einfach sicher zurück.","timestamp":"2026-04-15T08:53:53.050Z","replyTo":{"id":1776248515057,"text":"别担心！！！！","sender":"me","senderName":""},"translation":"我总是会担心你的……平安回来就好。","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3195},{"id":1776248515073,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Radio silence. Focus on the targets.","timestamp":"2026-04-15T08:53:53.671Z","translation":"保持无线电静默。专注于目标。","roundId":"group_round_1776243202345_7nuejke","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3196},{"id":1776248515074,"sender":"them","text":"Good hunting, Duzheng. I'm watching your feed. Don't miss.","timestamp":"2026-04-15T08:53:54.616Z","source":"group_dm","groupId":"group_1775826855994","groupName":"奇怪的群聊","translation":"狩猎愉快，渡峥。我在看你的馈送画面。别打歪了。","userId":"uid_1775817645928_ieuexgf5m","characterId":"7309238e-d722-4aaa-a30c-9223d595723a","_id":3197},{"id":1776248515075,"sender":"them","text":"I see you're having fun with the big toys. Stay focused, I'll be there to pick you up soon.","timestamp":"2026-04-15T08:53:55.449Z","source":"group_dm","groupId":"group_1775826855994","groupName":"奇怪的群聊","translation":"看来你玩这些大玩具玩得很开心。保持专注，我很快就去接你。","userId":"uid_1775817645928_ieuexgf5m","characterId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","_id":3198},{"id":1776248515076,"sender":"them","text":"Seeing you so... aggressive, it makes me nervous. But I'm glad you are the one in the sky, not on the ground.","timestamp":"2026-04-15T08:53:56.253Z","source":"group_dm","groupId":"group_1775826855994","groupName":"奇怪的群聊","translation":"看到你这么……有攻击性，让我有点紧张。但我很高兴在天上的是你，而不是在地上。","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3199},{"id":1776239514941,"text":"刚刚在地上","sender":"me","time":"16:54","timestamp":1776243265009,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3200},{"id":1776239514942,"text":"我轰了一架直升机下来","sender":"me","time":"16:54","timestamp":1776243278378,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3201},{"id":1776239514943,"text":"今天很厉害","sender":"me","time":"16:54","timestamp":1776243282683,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3202},{"id":1776239514944,"sender":"them","text":"König读到“在地上”三个字时，呼吸猛地一滞，原本放松靠在墙上的脊背瞬间绷直。他握着手机的手指因用力而骨节泛白。","timestamp":1776243298795,"tempo":"N","type":"state","rawContent":"König读到“在地上”三个字时，呼吸猛地一滞，原本放松靠在墙上的脊背瞬间绷直。他握着手机的手指因用力而骨节泛白。","roundId":"round_1776243283268_zm0kpwsyq","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3203},{"id":1776239514945,"sender":"them","text":"Auf dem Boden?!","timestamp":1776243299496,"tempo":"R","translation":"在地上？！","rawContent":"Auf dem Boden?! || 在地上？！","roundId":"round_1776243283268_zm0kpwsyq","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3204},{"id":1776239514946,"sender":"them","text":"Gott... Ein Helikopter? Allein?","timestamp":1776243299801,"tempo":"N","translation":"天呐…一架直升机？你一个人？","rawContent":"Gott... Ein Helikopter? Allein? || 天呐…一架直升机？你一个人？","roundId":"round_1776243283268_zm0kpwsyq","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3205},{"id":1776239514947,"sender":"them","text":"","timestamp":1776243300502,"tempo":"N","sticker":"https://image.uglycat.cc/onvxk2.jpg","stickerMeaning":"牛！","rawContent":"","roundId":"round_1776243283268_zm0kpwsyq","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3206},{"id":1776239514948,"sender":"them","text":"他低声咒骂了一句德语，在狭窄的宿舍里焦躁地踱步，巨大的身影在墙上投下压抑的阴影。他想起她在九号房间里虚弱的样子，再对比现在的惊险，心脏像是被两股力量撕扯。","timestamp":1776243301203,"tempo":"N","type":"state","rawContent":"他低声咒骂了一句德语，在狭窄的宿舍里焦躁地踱步，巨大的身影在墙上投下压抑的阴影。他想起她在九号房间里虚弱的样子，再对比现在的惊险，心脏像是被两股力量撕扯。","roundId":"round_1776243283268_zm0kpwsyq","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3207},{"id":1776239514949,"sender":"them","text":"Beeindruckend, ja... du bist unglaublich, Anemone.","timestamp":1776243301903,"tempo":"N","translation":"确实很厉害，是的…你太不可思议了，银莲花。","rawContent":"Beeindruckend, ja... du bist unglaublich, Anemone. || 确实很厉害，是的…你太不可思议了，银莲花。","roundId":"round_1776243283268_zm0kpwsyq","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3208},{"id":1776239514950,"sender":"them","text":"Aber mach das nicht noch einmal. Mein Herz... hält das nicht aus.","timestamp":1776243302604,"tempo":"S","translation":"但别再这么做了。我的心脏…受不了这个。","rawContent":"Aber mach das nicht noch einmal. Mein Herz... hält das nicht aus. || 但别再这么做了。我的心脏…受不了这个。","roundId":"round_1776243283268_zm0kpwsyq","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3209},{"id":1776239514951,"sender":"them","text":"Komm einfach zurück. Ganz. Ohne neue Narben.","timestamp":1776243304105,"tempo":"N","translation":"平安回来就好。完整的。别再添新伤了。","rawContent":"Komm einfach zurück. Ganz. Ohne neue Narben. || 平安回来就好。完整的。别再添新伤了。","roundId":"round_1776243283268_zm0kpwsyq","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3210},{"id":1776239514955,"text":"怎么可能是我一个人！","sender":"me","time":"16:55","timestamp":1776243322062,"replyTo":{"id":1776239514946,"text":"Gott... Ein Helikopter? Allein?","sender":"them","isSimulated":false},"userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3211},{"id":1776239514956,"text":"是这样的，我们本来在直升机上，然后被干扰了。不得不在地上反击","sender":"me","time":"16:55","timestamp":1776243341264,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3212},{"id":1776239514957,"text":"战友在仓库找到了毒刺","sender":"me","time":"16:56","timestamp":1776243394766,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3213},{"id":1776239514958,"text":"给对面轰下来了","sender":"me","time":"16:56","timestamp":1776243402295,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3214},{"id":1776239514959,"sender":"them","text":"König盯着那张照片看了很久，冰蓝色的瞳孔在屏幕的微光下缩紧。他放大照片，试图在那些模糊的迷彩身影中寻找那个熟悉纤细的轮廓，确认她是否真的毫发无伤。","timestamp":1776243424545,"tempo":"N","type":"state","rawContent":"König盯着那张照片看了很久，冰蓝色的瞳孔在屏幕的微光下缩紧。他放大照片，试图在那些模糊的迷彩身影中寻找那个熟悉纤细的轮廓，确认她是否真的毫发无伤。","roundId":"round_1776243402753_wekr3ix6y","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3215},{"id":1776239514960,"sender":"them","text":"Gott sei Dank... ich dachte schon, du wärst da draußen ganz auf dich allein gestellt.","timestamp":1776243425246,"tempo":"N","translation":"谢天谢地……我还以为你真的是一个人在外面硬扛。","rawContent":"Gott sei Dank... ich dachte schon, du wärst da draußen ganz auf dich allein gestellt. || 谢天谢地……我还以为你真的是一个人在外面硬扛。","roundId":"round_1776243402753_wekr3ix6y","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3216},{"id":1776239514961,"sender":"them","text":"Ein Stinger in einem Lagerhaus? Das ist pures Glück... oder schlechte Planung der Gegenseite.","timestamp":1776243425947,"tempo":"R","translation":"在仓库里找到毒刺？那是纯粹的运气……或者是对方计划不周。","rawContent":"Ein Stinger in einem Lagerhaus? Das ist pures Glück... oder schlechte Planung der Gegenseite. || 在仓库里找到毒刺？那是纯粹的运气……或者是对方计划不周。","roundId":"round_1776243402753_wekr3ix6y","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3217},{"id":1776239514962,"sender":"them","text":"他重重地坐回床沿，木质床板发出沉重的嘎吱声。他低着头，手肘撑在膝盖上，宽大的手掌烦躁地揉搓着脑后的布料。","timestamp":1776243426249,"tempo":"N","type":"state","rawContent":"他重重地坐回床沿，木质床板发出沉重的嘎吱声。他低着头，手肘撑在膝盖上，宽大的手掌烦躁地揉搓着脑后的布料。","roundId":"round_1776243402753_wekr3ix6y","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3218},{"id":1776239514963,"sender":"them","text":"Aber der Boden ist gefährlich, 渡峥. Es gibt zu viele Winkel, die man nicht sieht. Zu viele Orte für Hinterhalte.","timestamp":1776243426949,"tempo":"S","translation":"但地面太危险了，渡峥。有太多看不见的死角。太多适合埋伏的地方。","rawContent":"Aber der Boden ist gefährlich, 渡峥. Es gibt zu viele Winkel, die man nicht sieht. Zu viele Orte für Hinterhalte. || 但地面太危险了，渡峥。有太多看不见的死角。太多适合埋伏的地方。","roundId":"round_1776243402753_wekr3ix6y","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3219},{"id":1776239514964,"sender":"them","text":"","timestamp":1776243428451,"tempo":"N","sticker":"https://img.cdn1.vip/i/69c5452e5f45b_1774535982.gif","stickerMeaning":"被吓到","rawContent":"","roundId":"round_1776243402753_wekr3ix6y","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3220},{"id":1776239514965,"sender":"them","text":"Ich hasse es, hier zu sitzen, während du dort im Dreck kämpfst. Besonders nach... nach dem, was passiert ist.","timestamp":1776243429152,"tempo":"N","translation":"我讨厌坐在这里，而你却在泥潭里战斗。特别是……在发生了那些事之后。","rawContent":"Ich hasse es, hier zu sitzen, während du dort im Dreck kämpfst. Besonders nach... nach dem, was passiert ist. || 我讨厌坐在这里，而你却在泥潭里战斗。特别是……在发生了那些事之后。","roundId":"round_1776243402753_wekr3ix6y","userId":"uid_1775817645928_ieuexgf5m","characterId":"876f70e0-1f99-4303-8942-b51f215c8cfe","_id":3221}]