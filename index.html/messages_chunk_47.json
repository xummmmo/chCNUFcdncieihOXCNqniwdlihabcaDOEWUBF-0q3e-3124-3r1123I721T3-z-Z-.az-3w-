[{"id":1776241185817,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"*Ach*, so my little 'final insurance' is back. And still in one piece. Good.","timestamp":"2026-04-15T06:51:56.511Z","translation":"啊，我的小‘最后一道保险’回来了。而且还完好无损。很好。","roundId":"group_round_1776235901850_3m2n3fn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2879},{"id":1776241185818,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Gut. Ich bin... froh, das zu hören. Bist du wirklich... unverletzt?","timestamp":"2026-04-15T06:51:56.888Z","translation":"好。我……很高兴听到这个。你真的……没有受伤吗？","roundId":"group_round_1776235901850_3m2n3fn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2880},{"id":1776241185819,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"(Возвращение подтверждено. Ты наша.)","timestamp":"2026-04-15T06:51:57.492Z","translation":"(回归确认。你是我们的。)","roundId":"group_round_1776235901850_3m2n3fn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2881},{"id":1776241185820,"sender":"me","text":"有的，有四个其他组织的士兵","replyTo":{"id":1776241185816,"text":"Good. Just 'safe and sound'? No surprises then.","sender":"them","senderName":"Simon Riley"},"timestamp":"2026-04-15T06:52:17.625Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2882},{"id":1776241185821,"sender":"me","text":"牺牲了","replyTo":null,"timestamp":"2026-04-15T06:52:21.439Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2883},{"id":1776241185822,"sender":"me","text":"我没什么大碍","replyTo":null,"timestamp":"2026-04-15T06:52:34.916Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2884},{"id":1776241185823,"sender":"me","text":"[圖片]","timestamp":"2026-04-15T06:52:46.436Z","imageSummary":"一名全副武装的士兵正在破门，画面从持枪者的第一人称视角拍摄。","imageRef":3,"userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2885},{"id":1776241185824,"sender":"me","text":"当时破门的时候偷偷拍了张照片","replyTo":{"id":1776241185823,"text":"[圖片]","sender":"me","senderName":""},"timestamp":"2026-04-15T06:53:08.526Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2886},{"id":1776241185840,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"'No big deal', you said. Four dead isn't 'no big deal', Duzheng. You were in the thick of it.","timestamp":"2026-04-15T06:54:07.571Z","replyTo":{"text":"有四个其他组织的士兵 牺牲了","sender":"them","senderName":""},"translation":"你说‘没什么大碍’。渡峥，四个死人可不是‘没什么大碍’。你当时身处险境。","roundId":"group_round_1776236034844_x3ompne","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2902},{"id":1776241185841,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"You say 'no big deal', but that picture tells a different story. You're sure you're alright, Kid?","timestamp":"2026-04-15T06:54:07.908Z","replyTo":{"id":1776241185822,"text":"我没什么大碍","sender":"me","senderName":""},"translation":"你说是‘没什么大碍’，但这照片可说明了不同的情况。你确定没事吗，孩子？","roundId":"group_round_1776236034844_x3ompne","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2903},{"id":1776241185842,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Vier Soldaten... Und du hast Zeit für ein Erinnerungsfoto. Effizient.","timestamp":"2026-04-15T06:54:08.265Z","translation":"四名士兵……你还有时间拍纪念照。效率真高。","roundId":"group_round_1776236034844_x3ompne","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2904},{"id":1776241185843,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Vier Tote... Das ist viel. Bist du wirklich unverletzt, Duzheng? Ich mache mir Sorgen.","timestamp":"2026-04-15T06:54:08.722Z","replyTo":{"id":1776241185822,"text":"我没什么大碍","sender":"me","senderName":""},"translation":"四个人死了……这很多。你真的没受伤吗，渡峥？我很担心。","roundId":"group_round_1776236034844_x3ompne","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2905},{"id":1776241185844,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"(他们死了不重要。你活着回来了。这是最重要的。)","timestamp":"2026-04-15T06:54:09.082Z","translation":"(他们死了不重要。你活着回来了。这是最重要的。)","roundId":"group_round_1776236034844_x3ompne","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2906},{"id":1776241185845,"sender":"me","text":"嗯…他们和我一样，都是没有父母的…耗材？","replyTo":{"id":1776241185840,"text":"'No big deal', you said. Four dead isn't 'no big deal', Duzheng. You were in the thick of it.","sender":"them","senderName":"Simon Riley"},"timestamp":"2026-04-15T06:57:04.068Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2907},{"id":1776241185846,"sender":"me","text":"去之前都知道是什么情况","replyTo":null,"timestamp":"2026-04-15T06:57:23.355Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2908},{"id":1776241185847,"sender":"me","text":"小小的擦伤，不严重","replyTo":{"id":1776241185843,"text":"Vier Tote... Das ist viel. Bist du wirklich unverletzt, Duzheng? Ich mache mir Sorgen.","sender":"them","senderName":"König"},"timestamp":"2026-04-15T06:57:32.643Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2909},{"id":1776241185848,"sender":"me","text":"甚至没流血","replyTo":null,"timestamp":"2026-04-15T06:57:41.620Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2910},{"id":1776241185849,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"'Expendable'? You're not a number, Duzheng. And knowing the risks doesn't make the outcome any less fatal. You're still here. They're not. That's the difference.","timestamp":"2026-04-15T06:58:01.014Z","replyTo":{"text":"嗯…他们和我一样，都是没有父母的…耗材？去之前都知道是什么情况","sender":"them","senderName":""},"translation":"‘耗材’？你不是一个数字，渡峥。知道风险并不能让结果不致命。你还活着，他们没了。这就是区别。","roundId":"group_round_1776236263028_mp815sx","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2911},{"id":1776241185850,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"'Minor scrapes' usually don't come after a firefight that leaves four men dead. Let me see them when you get back.","timestamp":"2026-04-15T06:58:01.382Z","replyTo":{"text":"小小的擦伤，不严重甚至没流血","sender":"them","senderName":""},"translation":"‘小小的擦伤’通常不会发生在一场导致四人死亡的枪战之后。等你回来让我看看。","roundId":"group_round_1776236263028_mp815sx","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2912},{"id":1776241185851,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"*Ach*, 'expendable'. A harsh truth, but often accurate. Still, you're the one who returned. That's what matters to me.","timestamp":"2026-04-15T06:58:01.878Z","translation":"*啊*，‘耗材’。一个残酷的事实，但往往很准确。不过，你是那个活着回来的。这对我来说才重要。","roundId":"group_round_1776236263028_mp815sx","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2913},{"id":1776241185852,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Duzheng... *Bitte*, lass mich das sehen. Kleine Kratzer können sich infizieren. Ich will sicher sein.","timestamp":"2026-04-15T06:58:02.271Z","replyTo":{"text":"小小的擦伤，不严重甚至没流血","sender":"them","senderName":""},"translation":"渡峥……*拜托*，让我看看。小小的擦伤也可能感染。我需要确认。","roundId":"group_round_1776236263028_mp815sx","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2914},{"id":1776241185853,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"(他们是失败者。你活着。这是唯一的标准。你的伤口，我们来处理。)","timestamp":"2026-04-15T06:58:02.895Z","translation":"(他们是失败者。你活着。这是唯一的标准。你的伤口，我们来处理。)","roundId":"group_round_1776236263028_mp815sx","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2915},{"id":1776241185854,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Don't brush it off. Every scratch, every bruise tells a story. And ignoring them only makes you weaker.","timestamp":"2026-04-15T06:58:03.393Z","translation":"别敷衍。每一次擦伤，每一次淤青，都在讲述一个故事。忽视它们只会让你变得更脆弱。","roundId":"group_round_1776236263028_mp815sx","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2916},{"id":1776241185855,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Exactly, Ghost. And Kid, I don't care if it's 'not bleeding'. You're coming home, and we're checking you over. No arguments.","timestamp":"2026-04-15T06:58:03.727Z","translation":"没错，Ghost。还有，小鬼，我不在乎它是不是‘没流血’。你回家后，我们会检查你。不许争辩。","roundId":"group_round_1776236263028_mp815sx","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2917},{"id":1776241185882,"sender":"me","text":"啊好严格！！！","replyTo":{"id":1776241185855,"text":"Exactly, Ghost. And Kid, I don't care if it's 'not bleeding'. You're coming home, and we're checking you over. No arguments.","sender":"them","senderName":"Keegan"},"timestamp":"2026-04-15T07:08:04.368Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2944},{"id":1776241185883,"sender":"me","text":"我在休息了","replyTo":null,"timestamp":"2026-04-15T07:08:08.180Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2945},{"id":1776241185884,"sender":"me","text":"整整装备","replyTo":null,"timestamp":"2026-04-15T07:08:15.050Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2946},{"id":1776241185885,"sender":"me","text":"吃点东西","replyTo":null,"timestamp":"2026-04-15T07:08:18.450Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2947},{"id":1776241185886,"sender":"me","text":"然后去下一场","replyTo":null,"timestamp":"2026-04-15T07:08:24.200Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2948},{"id":1776241185887,"sender":"me","text":"战争总是这么…残酷","replyTo":null,"timestamp":"2026-04-15T07:08:37.087Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2949},{"id":1776241185888,"sender":"me","text":"希望我在前面杀人的时候，队友不会手滑给我一梭子","replyTo":null,"timestamp":"2026-04-15T07:08:51.835Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2950},{"id":1776247595329,"sender":"me","text":"这种伤还有救吗！！！！（环境是在嘈杂的战场，周围有枪声和喊叫声）","replyTo":null,"timestamp":"2026-04-15T07:38:33.262Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":2972,"rawContent":"这种伤还有救吗！！！！（环境是在嘈杂的战场，周围有枪声和喊叫声）","isHtml":false,"edited":true,"deleted":true},{"id":1776247809681,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Strict? Kid, it's about keeping you in one piece. Friendly fire isn't a joke, Duzheng. Be aware of your surroundings, always.","timestamp":"2026-04-15T07:44:23.288Z","replyTo":{"id":1776241185882,"text":"啊好严格！！！","sender":"me","senderName":""},"translation":"严格？孩子，这是为了让你完好无损。友军火力可不是玩笑，渡峥。时刻注意周围环境。","roundId":"group_round_1776239047750_vhvn2nn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3011},{"id":1776247809682,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"War is cruel. That's why you stay sharp. And watch your own back. Trust no one implicitly.","timestamp":"2026-04-15T07:44:23.920Z","replyTo":{"id":1776241185888,"text":"希望我在前面杀人的时候，队友不会手滑给我一梭子","sender":"me","senderName":""},"translation":"战争是残酷的。所以你要保持警惕。也要提防自己人。不要完全信任任何人。","roundId":"group_round_1776239047750_vhvn2nn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3012},{"id":1776247809683,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Ach, die Schrecken des Krieges. Aber du bist doch eine Überlebende, oder? Und was 'Friendly Fire' angeht... manchmal passieren Unfälle. Mach einfach, dass du nicht *zu* ablenkend bist.","timestamp":"2026-04-15T07:44:24.324Z","translation":"啊，战争的残酷。但你是个幸存者，不是吗？至于“友军火力”……有时候事故会发生。只要别让自己*太*分心就好。","roundId":"group_round_1776239047750_vhvn2nn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3013},{"id":1776247809684,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Duzheng, bitte. Denk nicht so. Wir sind... Wir sind hier, um dich zu beschützen. Nicht um dich zu verletzen.","timestamp":"2026-04-15T07:44:24.939Z","translation":"渡峥，拜托。别那样想。我们是……我们在这里是为了保护你。不是为了伤害你。","roundId":"group_round_1776239047750_vhvn2nn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3014},{"id":1776247809685,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"(战争是残酷的。但这不重要。重要的是你。不要让任何人伤害你。包括你自己。)","timestamp":"2026-04-15T07:44:25.321Z","translation":"(War is cruel. But it doesn't matter. You are what matters. Don't let anyone hurt you. Including yourself.)","roundId":"group_round_1776239047750_vhvn2nn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3015},{"id":1776247809686,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"He's right, Duzheng. Your focus should be on the objective, not on what *might* happen from behind you.","timestamp":"2026-04-15T07:44:25.690Z","translation":"他说得对，渡峥。你的注意力应该集中在目标上，而不是你身后*可能*发生的事情。","roundId":"group_round_1776239047750_vhvn2nn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3016},{"id":1776247809687,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Listen to Ghost. He knows. And when you're done 're-equipping', you check in. Understand?","timestamp":"2026-04-15T07:44:26.271Z","translation":"听幽灵的。他懂。等你“整顿装备”完了，就来报个平安。明白吗？","roundId":"group_round_1776239047750_vhvn2nn","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3017},{"id":1776247809688,"sender":"me","text":"[發送了一張圖片 at  on 2026-04-15：渡峥身前倒着一个受了枪伤的年轻士兵，渡峥的手死死的捂住士兵腹部的伤口，献血顺着渡峥的手指缝流出。]","simulatedImageContent":"渡峥身前倒着一个受了枪伤的年轻士兵，渡峥的手死死的捂住士兵腹部的伤口，献血顺着渡峥的手指缝流出。","simulatedImageLocation":"","simulatedImageDate":"2026-04-15","timestamp":"2026-04-15T07:46:31.715Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3018},{"id":1776247809689,"sender":"me","text":"[語音：还有救吗！这他吗怎么救。腹部开放性伤口，刚刚他肠子流了一地，我给他塞回去了。]","voiceText":"还有救吗！这他吗怎么救。腹部开放性伤口，刚刚他肠子流了一地，我给他塞回去了。","isVoice":true,"voice":true,"timestamp":"2026-04-15T07:47:15.349Z","audioDuration":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3019},{"id":1776247809690,"sender":"me","text":"[語音：这新兵蛋子就不该来这。]","voiceText":"这新兵蛋子就不该来这。","isVoice":true,"voice":true,"timestamp":"2026-04-15T07:47:32.384Z","audioDuration":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3020},{"id":1776247809691,"sender":"me","text":"[語音：我操…怎么救他。]","voiceText":"我操…怎么救他。","isVoice":true,"voice":true,"timestamp":"2026-04-15T07:47:43.201Z","audioDuration":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3021},{"id":1776248391444,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Duzheng! Breathe. Status report. What's your position? Is anyone else with you?","timestamp":"2026-04-15T07:50:12.818Z","translation":"渡峥！呼吸。报告情况。你在哪？还有别人跟你在一起吗？","roundId":"group_round_1776239395524_lyf939s","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3034},{"id":1776248391445,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Duzheng, calm down. Focus on your breathing. Tell us exactly what happened. Are *you* hit?","timestamp":"2026-04-15T07:50:13.047Z","translation":"渡峥，冷静。深呼吸。告诉我们到底发生了什么。你受伤了吗？","roundId":"group_round_1776239395524_lyf939s","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3035},{"id":1776248391446,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Verloren. Es ist zu spät. Konzentriere dich auf deine eigene Sicherheit, Liebling.","timestamp":"2026-04-15T07:50:13.688Z","translation":"没救了。太迟了。专注于你自己的安全，亲爱的。","roundId":"group_round_1776239395524_lyf939s","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3036},{"id":1776248391447,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Duzheng! Atme. Lass ihn... Lass ihn los. Du bist die Wichtige.","timestamp":"2026-04-15T07:50:13.956Z","translation":"渡峥！呼吸。放开他……放开他。你才是重要的。","roundId":"group_round_1776239395524_lyf939s","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3037},{"id":1776248391448,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"(他已经死了。离开那里。你不能救他。专注于你自己。)","timestamp":"2026-04-15T07:50:14.242Z","translation":"(Он мертв. Уходи оттуда. Ты не можешь его спасти. Сосредоточься на себе.)","roundId":"group_round_1776239395524_lyf939s","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3038,"deleted":true},{"id":1776248391449,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Stop trying to save him. He's gone. Move. Now.","timestamp":"2026-04-15T07:50:14.468Z","translation":"别再试图救他了。他走了。动起来。现在。","roundId":"group_round_1776239395524_lyf939s","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3039},{"id":1776248391450,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Duzheng, pull back. You did what you could. Get to cover.","timestamp":"2026-04-15T07:50:15.070Z","translation":"渡峥，撤回来。你已经尽力了。找掩护。","roundId":"group_round_1776239395524_lyf939s","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3040}]