[{"id":1776248391451,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Duzheng, bitte! Deine Hände... lass los. Es ist vorbei.","timestamp":"2026-04-15T07:50:15.381Z","translation":"渡峥，求你了！你的手……放手吧。结束了。","roundId":"group_round_1776239395524_lyf939s","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3041},{"id":1776248391452,"sender":"me","text":"他才17岁！","replyTo":null,"timestamp":"2026-04-15T07:50:53.953Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3042,"deleted":true},{"id":1776248391453,"sender":"me","text":"操…","replyTo":null,"timestamp":"2026-04-15T07:51:06.645Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3043,"deleted":true},{"id":1776248514939,"sender":"me","text":"做不到把他丢下","replyTo":null,"timestamp":"2026-04-15T07:52:58.962Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3054,"deleted":true},{"id":1776248514940,"sender":"me","text":"他才16","replyTo":null,"timestamp":"2026-04-15T07:53:02.714Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3055,"deleted":true},{"id":1776248514941,"sender":"me","text":"告诉我怎么处理他的伤口，","replyTo":null,"timestamp":"2026-04-15T07:53:14.064Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3056,"deleted":true},{"id":1776248514962,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"That's the cold truth, Duzheng. You can't save everyone. Especially not this one. Now, move your ass.","timestamp":"2026-04-15T08:01:16.633Z","roundId":"group_round_1776240059903_81337u8","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3077,"deleted":true},{"id":1776248514963,"sender":"me","text":"[圖片]","timestamp":"2026-04-15T08:06:47.568Z","imageSummary":"倒在草地上的士兵，面部朝上，身上穿着战术背心，旁边是持枪者的枪口。","imageRef":4,"userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3078},{"id":1776248514964,"sender":"me","text":"…no…………","replyTo":null,"timestamp":"2026-04-15T08:06:53.510Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3079},{"id":1776248514965,"sender":"me","text":"他没气了…","replyTo":null,"timestamp":"2026-04-15T08:06:59.628Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3080},{"id":1776248514966,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Confirmed. No time for grief now, Duzheng. Clear the area. Report when you're secure.","timestamp":"2026-04-15T08:07:24.494Z","translation":"确认。现在不是悲伤的时候，渡峥。清理区域。安全后汇报。","roundId":"group_round_1776240421048_51uiph3","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3081},{"id":1776248514967,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Understood. Fall back to a secure position, Kid. Don't linger. We'll debrief later.","timestamp":"2026-04-15T08:07:25.122Z","translation":"明白。撤退到安全位置，孩子。别逗留。我们稍后汇报。","roundId":"group_round_1776240421048_51uiph3","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3082},{"id":1776248514968,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Schade. Eine Lektion gelernt. Deine. Bewege dich.","timestamp":"2026-04-15T08:07:25.588Z","translation":"可惜。又一个学到了教训。你的。快走。","roundId":"group_round_1776240421048_51uiph3","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3083},{"id":1776248514969,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Es tut mir leid, Duzheng. Wirklich. Aber du musst... du musst dich von dort entfernen. Jetzt.","timestamp":"2026-04-15T08:07:26.072Z","translation":"我很抱歉，渡峥。真的。但是你必须……你现在必须离开那里。","roundId":"group_round_1776240421048_51uiph3","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3084},{"id":1776248514970,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"(确认。他已完成任务。你的任务是生存。离开那里。)","timestamp":"2026-04-15T08:07:26.440Z","translation":"(确认。他已完成任务。你的任务是生存。离开那里。)","roundId":"group_round_1776240421048_51uiph3","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3085},{"id":1776248514971,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Are you taking fire? Respond.","timestamp":"2026-04-15T08:07:26.719Z","translation":"是否正在交火？回答。","roundId":"group_round_1776240421048_51uiph3","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3086},{"id":1776248514972,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Duzheng. Talk to us. Are you alone?","timestamp":"2026-04-15T08:07:27.017Z","translation":"渡峥。跟我们说话。你是一个人吗？","roundId":"group_round_1776240421048_51uiph3","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3087},{"id":1776248514980,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Understood. Now move. Any hostiles in your immediate vicinity?","timestamp":"2026-04-15T08:17:52.838Z","translation":"明白了。现在撤退。你附近有敌人吗？","roundId":"group_round_1776241063904_rk546dt","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3095},{"id":1776248514981,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Duzheng... Es tut mir so leid. Aber du musst da weg. Dein Leben ist wichtiger.","timestamp":"2026-04-15T08:17:53.288Z","translation":"渡峥……我很难过。但你必须离开那里。你的生命更重要。","roundId":"group_round_1776241063904_rk546dt","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3096},{"id":1776248514982,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Duzheng, confirm your status. Are you compromised? Move. Now.","timestamp":"2026-04-15T08:17:53.521Z","translation":"渡峥，确认你的状态。你暴露了吗？撤退。现在。","roundId":"group_round_1776241063904_rk546dt","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3097},{"id":1776248514983,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Ein toter Soldat ist nur ein toter Soldat. Das ist der Krieg. Konzentriere dich auf das, was du kontrollieren kannst: deine Flucht.","timestamp":"2026-04-15T08:17:54.154Z","translation":"一个死去的士兵只是一个死去的士兵。这就是战争。专注于你能控制的事情：你的撤离。","roundId":"group_round_1776241063904_rk546dt","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3098},{"id":1776248514984,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"(悲伤是浪费时间。活着是你的责任。下一步。撤离。)","timestamp":"2026-04-15T08:17:54.771Z","translation":"(悲伤是浪费时间。活着是你的责任。下一步。撤离。)","roundId":"group_round_1776241063904_rk546dt","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3099},{"id":1776248514985,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Grief is a luxury you can't afford right now. Move.","timestamp":"2026-04-15T08:17:55.276Z","translation":"悲伤是你现在负担不起的奢侈品。撤退。","roundId":"group_round_1776241063904_rk546dt","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3100},{"id":1776248514986,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"I need an 'affirmative' you're moving, Kid.","timestamp":"2026-04-15T08:17:55.566Z","translation":"我需要你确认你正在撤离，孩子。","roundId":"group_round_1776241063904_rk546dt","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3101},{"id":1776248515031,"sender":"me","text":"没有撤退","replyTo":null,"timestamp":"2026-04-15T08:46:20.453Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3146},{"id":1776248515032,"sender":"me","text":"任务是前进","replyTo":null,"timestamp":"2026-04-15T08:46:24.247Z","reactions":["😟"],"userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3147},{"id":"sys_1776242839749_2p","sender":"system","type":"system_notice","text":"Keegan 授予 渡峥 頭銜「别死在外面」","timestamp":"2026-04-15T08:47:19.749Z","roundId":"group_round_1776242815634_ph3hv2p","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3148},{"id":1776248515033,"sender":"them","senderCharId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","senderName":"Keegan","text":"Kid, focus. If the mission is forward, then clear your head first. I'm still in training, don't make me come find you.","timestamp":"2026-04-15T08:47:20.578Z","translation":"小孩，集中注意力。如果任务是前进，那就先清醒点。我还在训练，别逼我过去找你。","roundId":"group_round_1776242815634_ph3hv2p","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3149},{"id":1776248515034,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Forward? Right into the fire. Fine. But if you lose your head, you're as good as that boy. Stay sharp.","timestamp":"2026-04-15T08:47:21.058Z","replyTo":{"id":1776248515031,"text":"没有撤退","sender":"me","senderName":""},"translation":"前进？直接冲进火堆。行吧。但如果你丧失理智，你就跟那男孩没区别了。保持警惕。","roundId":"group_round_1776242815634_ph3hv2p","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3150},{"id":1776248515035,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Retreat is for those who have something to lose. You have us. Don't forget that. Move like a professional.","timestamp":"2026-04-15T08:47:21.518Z","translation":"撤退是给那些有退路的人准备的。你还有我们。别忘了这一点。表现得专业点。","roundId":"group_round_1776242815634_ph3hv2p","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3151},{"id":1776248515036,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"Wie mutig. Ein Heldengrab ist auch nur ein Grab, Schatzi. Aber wenn du unbedingt willst... pass auf deine Hände auf.","timestamp":"2026-04-15T08:47:21.903Z","translation":"真勇敢。英雄的坟墓说到底也只是个坟墓，宝贝。但如果你坚持的话……保护好你的手。","roundId":"group_round_1776242815634_ph3hv2p","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3152},{"id":1776248515037,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"表情包：偷看","timestamp":"2026-04-15T08:47:22.170Z","sticker":"https://img.cdn1.vip/i/69c5463d16c89_1774536253.gif","stickerMeaning":"偷看","roundId":"group_round_1776242815634_ph3hv2p","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3153},{"id":1776248515038,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Duzheng... Ich mag das nicht. Dieses 'Vorwärts' klingt gefährlich. Bitte... komm einfach zurück.","timestamp":"2026-04-15T08:47:22.739Z","translation":"渡峥……我不喜欢这样。这个‘前进’听起来很危险。求你……一定要回来。","roundId":"group_round_1776242815634_ph3hv2p","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3154},{"id":1776248515039,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"任務是絕對的。前進。我們不接受失敗，只接受妳。殺死所有阻礙妳的人。","timestamp":"2026-04-15T08:47:23.034Z","translation":"任务是绝对的。前进。我们不接受失败，只接受你。杀死所有阻碍你的人。","roundId":"group_round_1776242815634_ph3hv2p","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3155},{"id":1776248515040,"sender":"them","text":"You're spiraling. Stop. Focus on the next ten meters. Nothing else exists. Breathe, Duzheng.","timestamp":"2026-04-15T08:47:23.947Z","source":"group_dm","groupId":"group_1775826855994","groupName":"奇怪的群聊","translation":"你在失控。停下。盯着接下来的十米。除此之外什么都不存在。呼吸，渡峥。","userId":"uid_1775817645928_ieuexgf5m","characterId":"7309238e-d722-4aaa-a30c-9223d595723a","_id":3156},{"id":1776248515041,"sender":"them","text":"I'm checking the GPS on your comms. Stay on path. I'll be out of the water in 40 minutes. Don't you dare go offline.","timestamp":"2026-04-15T08:47:24.766Z","source":"group_dm","groupId":"group_1775826855994","groupName":"奇怪的群聊","translation":"我在盯着你通讯器的GPS。留在路线上。我40分钟后上岸。你敢给我掉线试试。","userId":"uid_1775817645928_ieuexgf5m","characterId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","_id":3157},{"id":1776239514935,"text":"收到","sender":"me","time":"16:47","timestamp":1776242861682,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","_id":3158},{"id":1776239514936,"text":"长官","sender":"me","time":"16:47","timestamp":1776242863215,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","_id":3159},{"id":1776239514937,"text":"没失控","sender":"me","time":"16:48","timestamp":1776242881340,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"7309238e-d722-4aaa-a30c-9223d595723a","_id":3160},{"id":1776239514938,"text":"我还是我","sender":"me","time":"16:48","timestamp":1776242887308,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"7309238e-d722-4aaa-a30c-9223d595723a","_id":3161},{"id":1776239514939,"text":"任务是前进","sender":"me","time":"16:48","timestamp":1776242896719,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"7309238e-d722-4aaa-a30c-9223d595723a","_id":3162},{"id":1776239514940,"text":"不会掉线了","sender":"me","time":"16:48","timestamp":1776242906006,"replyTo":null,"userId":"uid_1775817645928_ieuexgf5m","characterId":"823d41d3-a739-4c7f-ad03-55f7bd53cf24","_id":3163},{"id":1776248515042,"sender":"me","text":"i will","replyTo":{"id":1776248515039,"text":"任務是絕對的。前進。我們不接受失敗，只接受妳。殺死所有阻礙妳的人。","sender":"them","senderName":"Nikto"},"timestamp":"2026-04-15T08:48:53.711Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3164},{"id":1776248515043,"sender":"me","text":"别担心，我有分寸","replyTo":{"id":1776248515038,"text":"Duzheng... Ich mag das nicht. Dieses 'Vorwärts' klingt gefährlich. Bitte... komm einfach zurück.","sender":"them","senderName":"König"},"timestamp":"2026-04-15T08:49:04.885Z","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3165},{"id":1776248515044,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"'Sinn für Maße'? In einem Kriegsgebiet? Das ist der beste Witz, den ich heute gehört habe, Liebling.","timestamp":"2026-04-15T08:49:45.733Z","translation":"“有分寸”？在战区？这是我今天听过最好的笑话了，亲爱的。","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3166},{"id":1776248515045,"sender":"them","senderCharId":"35af8775-dc6b-4ee6-b13f-937ebaa4e8e8","senderName":"Krueger","text":"表情包：自信","timestamp":"2026-04-15T08:49:45.882Z","sticker":"https://img.cdn1.vip/i/69c5452e51af1_1774535982.gif","stickerMeaning":"自信","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3167},{"id":1776248515046,"sender":"them","senderCharId":"876f70e0-1f99-4303-8942-b51f215c8cfe","senderName":"König","text":"Maße stoppen keine Kugeln, Duzheng. Bitte... halte einfach den Kopf unten. Ich... ich kann dich von hier aus nicht sehen.","timestamp":"2026-04-15T08:49:46.333Z","replyTo":{"id":1776248515043,"text":"别担心，我有分寸","sender":"me","senderName":""},"translation":"分寸挡不住子弹，渡峥。拜托……把头低好。我……我从这里看不见你。","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3168},{"id":1776248515047,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Measure is for tailors. In the field, it's about survival. Don't get cocky because you survived one firefight.","timestamp":"2026-04-15T08:49:46.704Z","translation":"分寸是给裁缝用的。在战场上，只有生存。别因为在一次交火中活下来就自大。","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3169},{"id":1776248515048,"sender":"them","senderCharId":"8d279dcf-8bd7-42cb-9c2e-360a084898f7","senderName":"Nikto","text":"Хорошо. Очисти путь. Мы смотрим. Пусть кровь других станет твоей картой.","timestamp":"2026-04-15T08:49:47.068Z","replyTo":{"id":1776248515042,"text":"i will","sender":"me","senderName":""},"translation":"很好。清空道路。我们在看着。让别人的血成为你的地图。","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3170},{"id":1776248515049,"sender":"them","senderCharId":"7309238e-d722-4aaa-a30c-9223d595723a","senderName":"Simon Riley","text":"Tch. Don't listen to the Russian. Just keep your eyes moving. Left, right, above.","timestamp":"2026-04-15T08:49:47.337Z","translation":"切。别听那个俄国人的。保持你的眼睛在动。左边，右边，上方。","roundId":"group_round_1776242966151_hbo9y0k","userId":"uid_1775817645928_ieuexgf5m","characterId":"group_1775826855994","_id":3171}]